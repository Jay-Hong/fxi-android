<?xml version="1.0" encoding="utf-8"?>
<!-- S7 E5d-J: the journey test APK. It sends the fixture's control commands under its signature permission, sees the app's
     package, and (J2b) moves a saved task to the front after a process death. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.jay.fxi.e5djourney.permission.CONTROL" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <queries>
        <package android:name="com.jay.fxi" />
    </queries>

    <!-- S7 U3a: this test APK's own notification listener, so a journey counts every post of the app's notifications. The
         journey allows it for its run and takes the access back; only the system may bind it. -->
    <application>
        <service
            android:name="com.jay.fxi.e5djourney.test.E5dJourneyNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
