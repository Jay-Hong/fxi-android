<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup / device-transfer rules.

   D27: access epoch, capability epoch, cleanup markers and the pending-purge journal must never
   cross devices. Restoring an epoch onto a different install points cleanup at a namespace that
   never existed there, and restoring a `mayContain*Data` marker claims data that is not present.

   The plan's DoD ultimately wants an allowlist ("allowlisted DataStore만 복원") rather than these
   excludes. Converting the whole app to an allowlist changes restore behaviour for existing user
   preferences, so it is a separate change; this file excludes the new control-plane store now.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/fxi_access_epoch.preferences_pb" />
        <exclude domain="file" path="datastore/fxi_bank_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/fxi_access_epoch.preferences_pb" />
        <exclude domain="file" path="datastore/fxi_bank_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
